# Copy this file to .env at the repo root and fill in what you need.
# Every demo reads this one file (and an optional apps/<name>/.env on top of it),
# both when run on the host with `uv run ...` and in Docker via `docker compose`.

# --- Credentials -----------------------------------------------------------
# Simplest: ONE project API key (Logfire -> project -> Settings -> API Keys) with
# "Send telemetry" and Gateway access ticked. It is used for traces, model calls
# and the Platform API alike; leave the two variables below empty.
LOGFIRE_API_KEY=
# Least privilege instead: a write token for traces and a Gateway key for models.
LOGFIRE_TOKEN=
# Shown in the Logfire environment picker; keeps demo traffic separable.
LOGFIRE_ENVIRONMENT=local

# --- Models ----------------------------------------------------------------
# Pydantic AI Gateway key: one key for OpenAI, Anthropic, Google and more,
# with spend limits enforced in Logfire. Create one under Gateway -> API Keys.
PYDANTIC_AI_GATEWAY_API_KEY=
# Model strings used by the demos. Any Pydantic AI model string works here;
# drop the `gateway/` prefix and set the provider's own key (e.g. OPENAI_API_KEY)
# to call a provider directly instead of through the Gateway.
DEMO_MODEL=gateway/openai:gpt-5.2
DEMO_FAST_MODEL=gateway/anthropic:claude-haiku-4-5

# --- Optional: Logfire Platform API (apps/rbac) ---------------------------
# apps/rbac needs an ORGANIZATION API key in LOGFIRE_API_KEY (scopes in its README).
# Platform API base URL for your data region: https://api-us.pydantic.dev or https://api-eu.pydantic.dev
LOGFIRE_API_BASE_URL=https://api-us.pydantic.dev

# --- Optional: per-app knobs (defaults shown) ------------------------------
# apps/instrumentation: head-sample this fraction of traces (1.0 = keep everything).
LOGFIRE_SAMPLE_RATE=1.0
# apps/gateway-routing: a Gateway endpoint slug (Gateway -> Endpoints) to demo failover/load balancing.
GATEWAY_ROUTE=
GATEWAY_ROUTE_FORMAT=anthropic
GATEWAY_ROUTE_MODEL=claude-haiku-4-5
# apps/support-agent: fraction of live requests the online LLM judge scores.
JUDGE_SAMPLE_RATE=0.1
# apps/distributed-frontend: browser origin allowed by CORS, and the Logfire region the
# backend proxies browser spans to (https://logfire-eu.pydantic.dev for EU).
FRONTEND_ORIGIN=http://localhost:5173
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
# apps/mcp-sampling: where generated SVGs are written.
MCP_SAMPLING_OUTPUT_DIR=apps/mcp-sampling/output
# Services (instrumentation-serve, support-agent-serve, distributed-frontend-backend) bind here.
HOST=127.0.0.1
PORT=8000

# --- Optional: infrastructure used by some demos --------------------------
# Postgres for apps/memory and apps/durable-exec (docker compose provides one on 5433).
DATABASE_URL=postgresql://postgres@localhost:5433/postgres
# DBOS system database for apps/durable-exec (default: a local SQLite file; Postgres recommended for production).
DBOS_SYSTEM_DATABASE_URL=sqlite:///durable_exec_dbos.sqlite
# Temporal dev server for apps/durable-exec (docker compose provides one).
TEMPORAL_ADDRESS=localhost:7233

# --- Optional: docker compose host ports ----------------------------------
INSTRUMENTATION_PORT=8001
SUPPORT_AGENT_PORT=8002
DISTRIBUTED_BACKEND_PORT=8003
POSTGRES_PORT=5433
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
